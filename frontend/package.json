{
  "name": "hanyunjing-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "vue-tsc --noEmit && vite build --config vite.admin.config.ts"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "pinia": "^3.0.3",
    "three": "^0.180.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.6",
    "vue-tsc": "^2.2.12"
  }
}
